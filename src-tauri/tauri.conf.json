{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dotMD",
  "version": "0.1.0",
  "identifier": "com.dotmd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dotMD",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "dotMD",
    "copyright": "Copyright (c) 2026 dotMD contributors. MIT License.",
    "category": "Productivity",
    "shortDescription": "A fast, local Markdown scratchpad",
    "longDescription": "Summon dotMD from anywhere with a global shortcut, jot, and get out of the way. Notes are plain .md files on your own disk.",
    "homepage": "https://github.com/6-Clock/dotMD",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "dotMD"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
